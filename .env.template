# Copy to .env and fill in — never commit the real .env file.

# --- DagsHub / MLflow / DVC remote (same pattern as rakuten_mlops_services) ---
DAGSHUB_USER=your_dagshub_username
DAGSHUB_TOKEN=your_dagshub_token
MLFLOW_TRACKING_URI=https://dagshub.com/<user>/income-inequality-mlops.mlflow
MLFLOW_S3_ENDPOINT_URL=https://dagshub.com/api/v1/repo-buckets/s3/<user>
MLFLOW_ARTIFACT_URI=s3://income-inequality-mlops
MLFLOW_TRACKING_USERNAME=${DAGSHUB_USER}
MLFLOW_TRACKING_PASSWORD=${DAGSHUB_TOKEN}
MLFLOW_EXPERIMENT_NAME=income-inequality

# --- Airflow ---
AIRFLOW__CORE__FERNET_KEY=changeme_generate_with_fernet
AIRFLOW__WEBSERVER__SECRET_KEY=changeme_generate_random_hex
AIRFLOW_UID=50000

# --- Grafana ---
GF_SECURITY_ADMIN_PASSWORD=admin

# --- Service URLs (internal docker network) ---
TRAIN_API_URL=http://train-api:5002
PREDICT_API_URL=http://predict-api:5003

# --- Optional: skip DVC pull inside containers during local dev ---
SKIP_DVC_PULL=1

# --- Data source credentials (only WID.world needs a free API key; the
#     others expose fully public, unauthenticated REST endpoints) ---
WID_API_KEY=
